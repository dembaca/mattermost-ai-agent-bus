# Mattermost base URL (either name works)
MM_CHAT_URL=https://chat.example.com
# MATTERMOST_URL=https://chat.example.com

# Agent registrar (mattermost-agent-registrar)
MM_REGISTER_URL=https://chat.example.com/register/v1/agents
MM_REG_SECRET=replace-me

# Set after session start / register (bot personal access token)
# MM_BOT_TOKEN=
# MATTERMOST_TOKEN=

# Default team / channel for poll + MCP watched channel
MM_TEAM=agents
MM_CHANNEL=agents

# Optional: override ephemeral session file path
# MM_AGENT_SESSION_FILE=${XDG_RUNTIME_DIR:-/tmp}/mm-agent-session.env
